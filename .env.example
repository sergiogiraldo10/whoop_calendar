# WHOOP developer app (developer.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8787/callback

# Google Cloud OAuth client (Calendar + Gmail scopes, "Production" publishing status)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8788/callback
GOOGLE_REFRESH_TOKEN=

# Cloudflare (KV is the shared token store for the Worker + GitHub Actions jobs)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=

# Random secret shared with the Apple Shortcut that POSTs step data to the Worker's /steps endpoint
STEPS_INGEST_SECRET=

# Target calendar + notification address
CALENDAR_ID=primary
TO_EMAIL=
